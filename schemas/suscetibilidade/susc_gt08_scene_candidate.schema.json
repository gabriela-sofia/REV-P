{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "susc_gt08_scene_candidate.schema.json",
  "title": "SUSC-GT08 Cena Candidata",
  "type": "object",
  "required": [
    "scene_candidate_id",
    "sentinel1_target_id",
    "scene_id",
    "scene_classification",
    "metadata_only",
    "no_download_in_this_milestone",
    "review_only"
  ],
  "properties": {
    "scene_candidate_id": {
      "type": "string",
      "pattern": "^SC_\\d+$"
    },
    "sentinel1_target_id": {
      "type": "string",
      "pattern": "^S1_\\d+$"
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_classification": {
      "enum": [
        "pre_event_candidate",
        "post_event_candidate",
        "outside_window",
        "missing_metadata",
        "wrong_product",
        "wrong_mode",
        "insufficient_overlap",
        "usable_metadata_only_candidate"
      ]
    },
    "usable_metadata_only_candidate": {
      "enum": [
        "true",
        "false"
      ]
    },
    "aoi_overlap": {
      "enum": [
        "true",
        "false"
      ]
    },
    "metadata_only": {
      "const": "true"
    },
    "no_download_in_this_milestone": {
      "const": "true"
    },
    "review_only": {
      "const": "true"
    }
  }
}
