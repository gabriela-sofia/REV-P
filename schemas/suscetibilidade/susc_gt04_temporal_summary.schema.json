{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "susc_gt04_temporal_summary.schema.json",
  "title": "SUSC-GT04 Resumo de Precisao Temporal",
  "type": "object",
  "required": [
    "temporal_precision",
    "count",
    "average_temporal_confidence_score",
    "usable_window_count",
    "blocked_window_count",
    "eligible_for_training_count",
    "eligible_for_ground_truth_count",
    "score_v7_candidate_count"
  ],
  "properties": {
    "temporal_precision": {
      "enum": [
        "exact_day",
        "inferred_from_event_id",
        "publication_date_only",
        "date_range",
        "month_only",
        "year_only",
        "unknown",
        "invalid_or_conflicting"
      ]
    },
    "count": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "average_temporal_confidence_score": {
      "type": "string"
    },
    "usable_window_count": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "blocked_window_count": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "eligible_for_training_count": {
      "const": "0"
    },
    "eligible_for_ground_truth_count": {
      "const": "0"
    },
    "score_v7_candidate_count": {
      "const": "0"
    }
  }
}
