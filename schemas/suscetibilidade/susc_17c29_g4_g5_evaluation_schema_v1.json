{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C29 g4 g5 evaluation schema v1",
  "type": "object",
  "required": [
    "ground_reference_candidate_eval_id",
    "local_observed_event_candidate_id",
    "candidate_patch_id",
    "event_id",
    "G1_existencia_documental",
    "G2_confiabilidade_fonte",
    "G3_precisao_temporal",
    "G4_vinculo_espacial_evento",
    "G5_separacao_fenomeno",
    "G6_proveniencia_integridade",
    "G7_anti_leakage",
    "can_be_ground_reference_candidate",
    "can_be_ground_truth",
    "can_be_training_label",
    "can_unlock_17b",
    "blocking_reason",
    "review_only"
  ],
  "properties": {
    "ground_reference_candidate_eval_id": {
      "type": "string",
      "pattern": "^S17C29_GRCE_"
    },
    "can_be_ground_truth": {
      "const": "false"
    },
    "can_be_training_label": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    }
  }
}
