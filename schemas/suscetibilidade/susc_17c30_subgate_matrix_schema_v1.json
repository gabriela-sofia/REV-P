{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C30 subgate matrix schema v1",
  "type": "object",
  "required": [
    "subgate_matrix_id",
    "source_id",
    "candidate_patch_id",
    "event_id",
    "G1",
    "G2",
    "G3",
    "G4a",
    "G4b",
    "G4c",
    "G4d",
    "G4_full",
    "G5a",
    "G5b",
    "G5c",
    "G5d",
    "G5_full",
    "G6",
    "G7",
    "eligible_for_documentary_evidence",
    "eligible_for_ground_reference_candidate",
    "eligible_for_17b",
    "eligible_for_score_v7",
    "review_only"
  ],
  "properties": {
    "subgate_matrix_id": {"type": "string", "pattern": "^S17C30_SGM_"},
    "eligible_for_17b": {"const": "false"},
    "eligible_for_score_v7": {"const": "false"},
    "review_only": {"const": "true"}
  }
}
