{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C6 multimodal canary matrix schema",
  "type": "object",
  "description": "Schema review-only para a matriz canaria multimodal SUSC-17C6. O readiness score e operacional, nao cientifico, nao altera score v6, nao cria score v7, treino, label ou ground truth.",
  "required": [
    "canary_row_id",
    "candidate_patch_id",
    "event_id",
    "reference_candidate_id",
    "has_reference_geometry",
    "has_candidate_patch_link",
    "has_physical_static_features",
    "has_urban_territorial_features",
    "has_sentinel2_spectral_features",
    "has_rainfall_trigger_features",
    "has_documentary_evidence",
    "has_sar_observational_footprint",
    "has_embedding_input_tile",
    "has_embedding_vector",
    "multimodal_readiness_score_review_only",
    "missing_layers",
    "synthetic_placeholder_used",
    "usable_for_science",
    "eligible_for_17b_now",
    "eligible_for_training",
    "eligible_for_score_v7",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "canary_row_id": { "type": "string", "minLength": 1 },
    "candidate_patch_id": { "type": "string", "pattern": "^S17C6_CANARY_REC_" },
    "event_id": { "const": "REC_2022_05_24_30" },
    "reference_candidate_id": { "const": "S17C4_REF_REC_2022_05_24_30" },
    "has_reference_geometry": { "const": "true" },
    "has_candidate_patch_link": { "enum": ["true", "false"] },
    "has_physical_static_features": { "enum": ["true", "false"] },
    "has_urban_territorial_features": { "enum": ["true", "false"] },
    "has_sentinel2_spectral_features": { "enum": ["true", "false"] },
    "has_rainfall_trigger_features": { "enum": ["true", "false"] },
    "has_documentary_evidence": { "enum": ["true", "false"] },
    "has_sar_observational_footprint": { "enum": ["true", "false"] },
    "has_embedding_input_tile": { "enum": ["true", "false"] },
    "has_embedding_vector": { "enum": ["true", "false"] },
    "multimodal_readiness_score_review_only": { "type": "string", "minLength": 1 },
    "missing_layers": { "type": "string", "minLength": 1 },
    "synthetic_placeholder_used": { "enum": ["true", "false"] },
    "usable_for_science": { "const": "false" },
    "eligible_for_17b_now": { "const": "false" },
    "eligible_for_training": { "const": "false" },
    "eligible_for_score_v7": { "const": "false" },
    "review_only": { "const": "true" },
    "trainable": { "const": "false" },
    "ground_truth": { "const": "false" }
  },
  "additionalProperties": true
}
