{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C2 candidate footprint schema",
  "type": "object",
  "description": "Review-only fail-closed schema for SUSC-17C2 candidate SAR/official flood footprints. A candidate footprint is observational candidate evidence, never ground truth, never a label, never a score. It can only be technical_remote_sensing_flood_footprint_candidate and starts at qa_status=needs_review. It is never eligible for strong evaluation, calibration or 17B before human QA accepts it. No geometry is invented; blocked executions produce no footprint.",
  "required": [
    "candidate_footprint_id",
    "candidate_event_id",
    "execution_id",
    "event_date",
    "geometry_type",
    "geometry_source",
    "evidence_class",
    "source_authority",
    "annotation_method",
    "uncertainty_m",
    "spatial_resolution",
    "temporal_resolution",
    "pre_event_window",
    "post_event_window",
    "qa_status",
    "eligible_for_reference_registry",
    "eligible_for_strong_evaluation",
    "eligible_for_calibration",
    "eligible_for_17b",
    "review_only",
    "trainable",
    "ground_truth",
    "not_ground_truth_reason"
  ],
  "properties": {
    "candidate_footprint_id": { "type": "string", "minLength": 1 },
    "candidate_event_id": { "type": "string", "minLength": 1 },
    "execution_id": { "type": "string", "minLength": 1 },
    "event_date": { "type": "string", "minLength": 1 },
    "geometry_type": {
      "enum": ["Polygon", "MultiPolygon", "Point", "not_available"]
    },
    "geometry_source": { "type": "string", "minLength": 1 },
    "evidence_class": {
      "enum": ["technical_remote_sensing_flood_footprint_candidate"]
    },
    "source_authority": { "type": "string", "minLength": 1 },
    "annotation_method": { "type": "string", "minLength": 1 },
    "uncertainty_m": { "type": "string", "minLength": 1 },
    "spatial_resolution": { "type": "string", "minLength": 1 },
    "temporal_resolution": { "type": "string", "minLength": 1 },
    "pre_event_window": { "type": "string", "minLength": 1 },
    "post_event_window": { "type": "string", "minLength": 1 },
    "qa_status": {
      "enum": [
        "needs_review", "accepted", "rejected", "ambiguous",
        "needs_more_source", "phenomenon_mismatch", "temporal_mismatch",
        "spatial_mismatch", "processing_artifact"
      ]
    },
    "eligible_for_reference_registry": { "enum": ["true", "false"] },
    "eligible_for_strong_evaluation": { "enum": ["true", "false"] },
    "eligible_for_calibration": { "enum": ["true", "false"] },
    "eligible_for_17b": { "enum": ["true", "false"] },
    "review_only": { "const": "true" },
    "trainable": { "const": "false" },
    "ground_truth": { "const": "false" },
    "not_ground_truth_reason": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
