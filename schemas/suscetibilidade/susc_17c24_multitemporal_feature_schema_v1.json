{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C24 multitemporal feature schema v1",
  "type": "object",
  "required": [
    "multitemporal_feature_id",
    "candidate_patch_id",
    "event_id",
    "feature_name",
    "scene_count",
    "temporal_mean",
    "temporal_median",
    "temporal_min",
    "temporal_max",
    "temporal_std",
    "best_cloud_scene_value",
    "best_cloud_scene_date",
    "best_cloud_scene_cloud_cover",
    "cloud_cover_min",
    "cloud_cover_median",
    "temporal_span_days",
    "feature_value_real",
    "pre_event_only",
    "usable_for_science_now",
    "usable_for_training",
    "ground_truth",
    "eligible_for_score_v7",
    "eligible_for_17b",
    "review_only"
  ],
  "properties": {
    "multitemporal_feature_id": {
      "type": "string",
      "pattern": "^S17C24_MTFEAT_"
    },
    "usable_for_training": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    },
    "eligible_for_score_v7": {
      "const": "false"
    },
    "eligible_for_17b": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    }
  }
}
