{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C21 observational change schema v1",
  "type": "object",
  "required": [
    "observational_change_id",
    "candidate_patch_id",
    "event_id",
    "pre_event_scene_or_item_id",
    "post_event_scene_or_item_id",
    "change_object_type",
    "change_features_available",
    "change_interpretation_allowed",
    "can_support_visual_review",
    "can_support_ground_reference",
    "can_support_training",
    "can_support_score_v7",
    "blocking_reason_for_scientific_use",
    "review_only"
  ],
  "properties": {
    "observational_change_id": {
      "type": "string",
      "pattern": "^S17C21_OBSCHANGE_"
    },
    "can_support_ground_reference": {
      "const": "false"
    },
    "can_support_training": {
      "const": "false"
    },
    "can_support_score_v7": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    }
  }
}
