{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C4 official artifact inventory schema",
  "type": "object",
  "description": "Review-only fail-closed schema for SUSC-17C4 official artifact inventory. It records what official/cartographic artifacts exist locally, are remote-only, missing, PDF/ZIP without vector, or context-only. It never creates score v7, training data, labels or ground truth, never invents geometry/coordinate/date, never treats PE3D/MDE as event or a PDF/ZIP without explicit vector as strong. Private raw artifacts are referenced as pointers, never staged.",
  "required": [
    "artifact_id",
    "source_target_id",
    "event_id",
    "city",
    "region",
    "source_name",
    "artifact_name",
    "artifact_expected_format",
    "artifact_local_status",
    "artifact_path",
    "artifact_url_or_reference",
    "artifact_size_bytes",
    "sha256",
    "access_status",
    "priority",
    "expected_revp_use",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "source_target_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "city": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "source_name": { "type": "string", "minLength": 1 },
    "artifact_name": { "type": "string", "minLength": 1 },
    "artifact_expected_format": { "type": "string", "minLength": 1 },
    "artifact_local_status": {
      "enum": [
        "local_available",
        "remote_reference_only",
        "missing_source_artifact",
        "pdf_only",
        "zip_only",
        "context_layer_only",
        "blocked_access",
        "unknown"
      ]
    },
    "artifact_path": { "type": "string", "minLength": 1 },
    "artifact_url_or_reference": { "type": "string", "minLength": 1 },
    "artifact_size_bytes": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "minLength": 1 },
    "access_status": { "type": "string", "minLength": 1 },
    "priority": { "type": "string", "minLength": 1 },
    "expected_revp_use": { "type": "string", "minLength": 1 },
    "review_only": { "const": "true" },
    "trainable": { "const": "false" },
    "ground_truth": { "const": "false" }
  },
  "additionalProperties": true
}
