{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C5 patch grid inventory schema",
  "type": "object",
  "description": "Review-only schema for inventorying existing SUSC patch grids without changing patch datasets, creating official patches, training data, labels, score v7 or ground truth.",
  "required": [
    "patch_grid_id",
    "region",
    "source_dataset",
    "patch_id_prefix",
    "patch_count",
    "crs",
    "xmin",
    "ymin",
    "xmax",
    "ymax",
    "mean_patch_width_deg",
    "mean_patch_height_deg",
    "has_patch_bbox",
    "has_patch_geometry",
    "grid_status",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "patch_grid_id": { "type": "string", "minLength": 1 },
    "region": { "enum": ["Recife", "Curitiba", "Petropolis"] },
    "source_dataset": { "type": "string", "minLength": 1 },
    "patch_id_prefix": { "type": "string", "minLength": 1 },
    "patch_count": { "type": ["string", "integer"] },
    "crs": { "type": "string", "minLength": 1 },
    "xmin": { "type": "string", "minLength": 1 },
    "ymin": { "type": "string", "minLength": 1 },
    "xmax": { "type": "string", "minLength": 1 },
    "ymax": { "type": "string", "minLength": 1 },
    "mean_patch_width_deg": { "type": "string", "minLength": 1 },
    "mean_patch_height_deg": { "type": "string", "minLength": 1 },
    "has_patch_bbox": { "enum": ["true", "false"] },
    "has_patch_geometry": { "enum": ["true", "false"] },
    "grid_status": { "enum": ["existing_patch_grid", "missing_patch_grid"] },
    "review_only": { "const": "true" },
    "trainable": { "const": "false" },
    "ground_truth": { "const": "false" }
  },
  "additionalProperties": true
}
