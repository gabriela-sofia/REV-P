{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C4 extracted reference candidate schema",
  "type": "object",
  "description": "Review-only fail-closed schema for SUSC-17C4 reference candidates extracted from official artifacts. A candidate is created only when explicit geometry/coordinate exists; PDF/ZIP without vector, missing artifacts and context layers never produce one. A candidate is observational candidate evidence, never ground truth or label, and is never eligible for 17B before human QA accepted. No geometry/coordinate/date is invented; neighborhood/address without a coordinate is at most official_address_resolved_pending, never strong.",
  "required": [
    "reference_candidate_id",
    "event_id",
    "source_target_id",
    "artifact_id",
    "city",
    "region",
    "event_date_or_period",
    "phenomenon_type",
    "candidate_revp_class",
    "geometry_type",
    "geometry_source",
    "coordinate_source",
    "uncertainty_m",
    "spatial_precision",
    "temporal_precision",
    "eligible_for_patch_link",
    "eligible_for_17b_now",
    "qa_status",
    "not_ground_truth_reason",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "reference_candidate_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "source_target_id": { "type": "string", "minLength": 1 },
    "artifact_id": { "type": "string", "minLength": 1 },
    "city": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "event_date_or_period": { "type": "string", "minLength": 1 },
    "phenomenon_type": { "type": "string", "minLength": 1 },
    "candidate_revp_class": {
      "enum": [
        "official_observed_event_polygon",
        "official_observed_event_point",
        "official_address_resolved_pending",
        "documentary_context",
        "blocked"
      ]
    },
    "geometry_type": {
      "enum": ["Polygon", "MultiPolygon", "Point", "MultiPoint", "not_available"]
    },
    "geometry_source": { "type": "string", "minLength": 1 },
    "coordinate_source": { "type": "string", "minLength": 1 },
    "uncertainty_m": { "type": "string", "minLength": 1 },
    "spatial_precision": { "type": "string", "minLength": 1 },
    "temporal_precision": { "type": "string", "minLength": 1 },
    "eligible_for_patch_link": { "enum": ["true", "false"] },
    "eligible_for_17b_now": { "const": "false" },
    "qa_status": {
      "enum": ["needs_review", "accepted", "rejected", "ambiguous", "spatial_mismatch", "temporal_mismatch"]
    },
    "not_ground_truth_reason": { "type": "string", "minLength": 1 },
    "review_only": { "const": "true" },
    "trainable": { "const": "false" },
    "ground_truth": { "const": "false" }
  },
  "additionalProperties": true
}
