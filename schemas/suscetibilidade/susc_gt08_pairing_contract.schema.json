{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "susc_gt08_pairing_contract.schema.json",
  "title": "SUSC-GT08 Contrato de Pareamento",
  "type": "object",
  "required": [
    "pairing_id",
    "sentinel1_target_id",
    "pairing_status",
    "requires_pre_and_post",
    "requires_aoi_intersection",
    "metadata_only",
    "no_download_in_this_milestone",
    "review_only"
  ],
  "properties": {
    "pairing_id": {
      "type": "string",
      "pattern": "^PR_\\d+$"
    },
    "sentinel1_target_id": {
      "type": "string",
      "pattern": "^S1_\\d+$"
    },
    "pairing_status": {
      "enum": [
        "par_completo_pre_pos",
        "falta_cena_pre",
        "falta_cena_pos",
        "sem_par_valido",
        "bloqueado_por_aoi_ou_janela"
      ]
    },
    "requires_pre_and_post": {
      "const": "true"
    },
    "requires_aoi_intersection": {
      "const": "true"
    },
    "metadata_only": {
      "const": "true"
    },
    "no_download_in_this_milestone": {
      "const": "true"
    },
    "review_only": {
      "const": "true"
    }
  }
}
