{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C37 method equivalence schema v1",
  "type": "object",
  "required": [
    "method_equivalence_metric_id", "feature_name", "pearson_corr", "spearman_corr",
    "mae", "median_absolute_error", "relative_error_median", "official_min", "official_max",
    "recomputed_min", "recomputed_max", "scale_ratio_median", "rank_preservation_score",
    "equivalence_status", "review_only"
  ],
  "properties": {
    "method_equivalence_metric_id": {"type": "string", "pattern": "^S17C37_MEM_"},
    "equivalence_status": {"enum": ["equivalent", "calibratable", "incompatible", "insufficient_data"]},
    "review_only": {"const": "true"}
  }
}
