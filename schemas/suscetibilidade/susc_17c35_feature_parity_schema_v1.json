{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C35 feature parity schema v1",
  "type": "object",
  "required": [
    "feature_parity_id", "canary_patch_id", "sentinel2_parity", "chirps_parity",
    "terrain_parity", "drainage_parity", "hand_parity", "landcover_parity",
    "urban_proxy_parity", "normalization_parity", "official_equivalent_feature_count",
    "proxy_feature_count", "missing_required_feature_count", "feature_parity_ratio",
    "sufficient_for_full_score_replay", "sufficient_for_partial_component_replay",
    "blocking_reason", "review_only"
  ],
  "properties": {
    "feature_parity_id": {"type": "string", "pattern": "^S17C35_PAR_"},
    "review_only": {"const": "true"}
  }
}
