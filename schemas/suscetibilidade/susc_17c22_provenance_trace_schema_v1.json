{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C22 provenance trace schema v1",
  "type": "object",
  "required": [
    "provenance_trace_id",
    "candidate_patch_id",
    "event_id",
    "object_type",
    "feature_or_delta_name",
    "source_scene_or_item_id",
    "source_artifact_manifest_id",
    "artifact_path",
    "sha256",
    "source_role",
    "sensor_or_dataset",
    "temporal_role",
    "processing_chain",
    "replay_status",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "provenance_trace_id": {
      "type": "string",
      "pattern": "^S17C22_PROV_"
    },
    "review_only": {
      "const": "true"
    },
    "trainable": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    }
  }
}
