{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "susc_gt08_sentinel1_target.schema.json",
  "title": "SUSC-GT08 Alvo Sentinel-1",
  "type": "object",
  "required": [
    "sentinel1_target_id",
    "target_id",
    "aoi_status",
    "pairing_status",
    "ready_for_metadata_search",
    "can_execute_search_now",
    "can_download_now",
    "remains_review_only",
    "trainable",
    "eligible_for_training",
    "eligible_for_ground_truth",
    "score_v7_candidate",
    "rationale_pt"
  ],
  "properties": {
    "sentinel1_target_id": {
      "type": "string",
      "pattern": "^S1_\\d+$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^TGT_\\d+$"
    },
    "aoi_status": {
      "enum": [
        "aoi_forte_por_bbox_ou_geometria_patch",
        "aoi_parcial_por_centroide_ou_ponto",
        "aoi_contextual_insuficiente",
        "aoi_ausente",
        "aoi_invalida"
      ]
    },
    "pairing_status": {
      "enum": [
        "par_completo_pre_pos",
        "falta_cena_pre",
        "falta_cena_pos",
        "sem_par_valido",
        "bloqueado_por_aoi_ou_janela"
      ]
    },
    "ready_for_metadata_search": {
      "enum": [
        "true",
        "false"
      ]
    },
    "can_execute_search_now": {
      "const": "false"
    },
    "can_download_now": {
      "const": "false"
    },
    "remains_review_only": {
      "const": "true"
    },
    "trainable": {
      "const": "false"
    },
    "eligible_for_training": {
      "const": "false"
    },
    "eligible_for_ground_truth": {
      "const": "false"
    },
    "score_v7_candidate": {
      "const": "false"
    },
    "rationale_pt": {
      "type": "string",
      "minLength": 1
    }
  }
}
