{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C30 gate promotion schema v1",
  "type": "object",
  "required": [
    "gate_promotion_decision_id",
    "source_id",
    "candidate_patch_id",
    "event_id",
    "gate_name",
    "previous_status",
    "new_status",
    "opened_in_17c30",
    "promotion_level",
    "evidence_basis",
    "still_blocks_17b",
    "still_blocks_score_v7",
    "blocking_reason",
    "review_only"
  ],
  "properties": {
    "gate_promotion_decision_id": {"type": "string", "pattern": "^S17C30_PROMO_"},
    "promotion_level": {
      "enum": [
        "documentary_gate_opened",
        "subgate_opened",
        "full_gate_opened",
        "blocked_fail_closed"
      ]
    },
    "review_only": {"const": "true"}
  }
}
