{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C25 chirps feature schema v1",
  "type": "object",
  "required": [
    "rainfall_trigger_feature_id",
    "candidate_patch_id",
    "event_id",
    "feature_name",
    "feature_value",
    "feature_unit",
    "source_dataset",
    "source_manifest_id",
    "feature_value_real",
    "usable_for_science_now",
    "usable_for_training",
    "ground_truth",
    "eligible_for_score_v7",
    "eligible_for_17b",
    "review_only"
  ],
  "properties": {
    "rainfall_trigger_feature_id": {
      "type": "string",
      "pattern": "^S17C25_RAINFEAT_"
    },
    "usable_for_training": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    },
    "eligible_for_score_v7": {
      "const": "false"
    },
    "eligible_for_17b": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    }
  }
}
