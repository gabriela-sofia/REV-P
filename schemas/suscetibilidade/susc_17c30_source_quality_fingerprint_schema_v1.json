{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C30 source quality fingerprint schema v1",
  "type": "object",
  "required": [
    "source_quality_fingerprint_id",
    "source_id",
    "source_name",
    "source_family",
    "source_type",
    "authority_tier",
    "source_url",
    "artifact_manifest_id",
    "artifact_local_path",
    "artifact_acquired",
    "sha256",
    "parse_success",
    "publication_date_found",
    "event_date_found",
    "location_terms_found",
    "bairro_or_logradouro_found",
    "coordinate_or_geometry_found",
    "phenomenon_terms_found",
    "official_links_found",
    "source_authority_score",
    "artifact_acquisition_score",
    "event_specificity_score",
    "temporal_signal_score",
    "spatial_signal_score",
    "phenomenon_signal_score",
    "parseability_score",
    "linkage_potential_score",
    "multimodal_trigger_score",
    "promotion_safety_score",
    "total_source_quality_score",
    "source_quality_class",
    "candidate_event_created",
    "eligible_for_documentary_evidence",
    "eligible_for_patch_link",
    "eligible_for_ground_reference_candidate",
    "eligible_for_ground_truth",
    "eligible_for_training",
    "eligible_for_score_v7",
    "blocking_reason",
    "review_only"
  ],
  "properties": {
    "source_quality_fingerprint_id": {"type": "string", "pattern": "^S17C30_FP_"},
    "eligible_for_ground_truth": {"const": "false"},
    "eligible_for_training": {"const": "false"},
    "eligible_for_score_v7": {"const": "false"},
    "review_only": {"const": "true"}
  }
}
