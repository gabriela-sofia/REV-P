{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C8 extracted candidate feature row schema v1",
  "type": "object",
  "required": [
    "candidate_patch_id",
    "feature_name",
    "feature_value",
    "feature_unit",
    "aggregation_method",
    "source_dataset",
    "source_artifact",
    "source_pipeline",
    "feature_value_real",
    "synthetic_placeholder",
    "usable_for_science_now",
    "blocking_reason",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "feature_value_real": {
      "enum": [
        "true",
        "false"
      ]
    },
    "synthetic_placeholder": {
      "const": "false"
    },
    "usable_for_science_now": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    },
    "trainable": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    }
  }
}
