{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-18C supervised gate recheck schema v1",
  "type": "object",
  "required": [
    "supervised_gate_recheck_id", "previous_status_18b", "label_contract_training_allowed",
    "supervised_training_allowed_after_18c", "supervised_training_executed",
    "supervised_training_ready_pending_approval", "blocking_reason", "safe_next_step", "review_only"
  ],
  "properties": {
    "supervised_gate_recheck_id": {"type": "string", "pattern": "^S18C_SGR_"},
    "supervised_training_executed": {"const": "false"},
    "review_only": {"const": "true"}
  }
}
