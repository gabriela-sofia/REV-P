{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C40 transparent component schema v1",
  "type": "object",
  "required": [
    "transparent_component_id", "patch_id", "patch_family", "event_id", "is_canary_patch",
    "is_original_control", "has_official_hydrological_occurrence_anchor",
    "absence_of_occurrence_is_true_negative", "HAND_value", "HAND_status", "TWI_value", "TWI_status",
    "TPI_250m_value", "TPI_status", "flow_acc_value", "flow_acc_status",
    "flow_acc_replacement_contract_required", "distance_to_official_drainage_m",
    "official_drainage_status", "urban_prop", "vegetation_prop", "water_prop", "NDVI_mean",
    "NDWI_mean", "MNDWI_mean", "NDBI_mean", "chirps_3d_sum", "chirps_7d_sum", "chirps_30d_sum",
    "component_availability_ratio", "review_only", "ground_truth", "training_label"
  ],
  "properties": {
    "transparent_component_id": {"type": "string", "pattern": "^S17C40_COMP_"},
    "absence_of_occurrence_is_true_negative": {"const": "false"},
    "flow_acc_replacement_contract_required": {"const": "true"},
    "review_only": {"const": "true"},
    "ground_truth": {"const": "false"},
    "training_label": {"const": "false"}
  }
}
