{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C SAR feasibility pack",
  "type": "object",
  "description": "SUSC-17C review-only fail-closed schema. No ground truth, no training, no score v7.",
  "required": [
    "candidate_event_id",
    "event_id",
    "source_id",
    "city",
    "region",
    "event_date",
    "pre_event_window",
    "post_event_window",
    "has_sentinel1_pre",
    "has_sentinel1_post",
    "has_sentinel2_context",
    "intersects_patch_region",
    "has_water_mask_source",
    "has_hand_or_slope_context",
    "sar_feasible",
    "sar_blocking_reason",
    "future_query_required",
    "metadata_sources",
    "review_only",
    "trainable",
    "ground_truth",
    "score_v7_allowed"
  ],
  "properties": {
    "candidate_event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "event_date": {
      "type": "string",
      "minLength": 1
    },
    "pre_event_window": {
      "type": "string",
      "minLength": 1
    },
    "post_event_window": {
      "type": "string",
      "minLength": 1
    },
    "has_sentinel1_pre": {
      "enum": [
        "true",
        "false"
      ]
    },
    "has_sentinel1_post": {
      "enum": [
        "true",
        "false"
      ]
    },
    "has_sentinel2_context": {
      "enum": [
        "true",
        "false"
      ]
    },
    "intersects_patch_region": {
      "enum": [
        "true",
        "false"
      ]
    },
    "has_water_mask_source": {
      "enum": [
        "true",
        "false"
      ]
    },
    "has_hand_or_slope_context": {
      "enum": [
        "true",
        "false"
      ]
    },
    "sar_feasible": {
      "enum": [
        "true",
        "false"
      ]
    },
    "sar_blocking_reason": {
      "type": "string",
      "minLength": 1
    },
    "future_query_required": {
      "enum": [
        "true",
        "false"
      ]
    },
    "metadata_sources": {
      "type": "string",
      "minLength": 1
    },
    "review_only": {
      "const": "true"
    },
    "trainable": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    },
    "score_v7_allowed": {
      "const": "false"
    }
  },
  "additionalProperties": true
}
