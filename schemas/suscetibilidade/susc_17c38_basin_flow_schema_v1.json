{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C38 basin-aware topography feature schema v1",
  "type": "object",
  "required": [
    "recomputed_feature_id", "patch_id", "dem_source", "pipeline_source", "domain_id",
    "recomputed_hand_mean", "recomputed_twi_mean", "recomputed_tpi_250m_mean",
    "recomputed_flow_acc_log_mean", "recomputed_elevation_mean", "recomputed_slope_mean",
    "valid_pixel_count", "patch_inside_domain", "edge_effect_risk",
    "method_equivalence_status", "review_only"
  ],
  "properties": {
    "recomputed_feature_id": {"type": "string", "pattern": "^S17C38_REC_"},
    "review_only": {"const": "true"}
  }
}
