{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "susc_gt07_qa_queue.schema.json",
  "title": "SUSC-GT07 Fila de QA",
  "type": "object",
  "required": [
    "qa_queue_id",
    "sar_target_id",
    "target_id",
    "qa_preparation_status",
    "current_qa_status",
    "qa_can_be_completed_now",
    "remains_review_only",
    "trainable",
    "eligible_for_training",
    "eligible_for_ground_truth",
    "score_v7_candidate",
    "rationale_pt"
  ],
  "properties": {
    "qa_queue_id": {
      "type": "string",
      "pattern": "^QAQ_\\d+$"
    },
    "sar_target_id": {
      "type": "string",
      "pattern": "^SAR_\\d+$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^TGT_\\d+$"
    },
    "qa_preparation_status": {
      "enum": [
        "pronto_para_qa_futuro",
        "aguardando_footprint_futuro",
        "aguardando_geometria_ou_aoi",
        "aguardando_separacao_fenomenologica",
        "bloqueado_para_qa",
        "fora_da_fila_qa"
      ]
    },
    "current_qa_status": {
      "enum": [
        "not_reviewed",
        "pending_review",
        "prepared_for_future_review"
      ]
    },
    "qa_can_be_completed_now": {
      "enum": [
        "true",
        "false"
      ]
    },
    "remains_review_only": {
      "const": "true"
    },
    "trainable": {
      "const": "false"
    },
    "eligible_for_training": {
      "const": "false"
    },
    "eligible_for_ground_truth": {
      "const": "false"
    },
    "score_v7_candidate": {
      "const": "false"
    },
    "rationale_pt": {
      "type": "string",
      "minLength": 1
    }
  }
}
