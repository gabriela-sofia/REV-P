{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C17 snapshot manifest schema v1",
  "type": "object",
  "required": [
    "snapshot_manifest_id",
    "network_snapshot_id",
    "source_name",
    "snapshot_path",
    "sha256",
    "size_bytes",
    "format",
    "content_type",
    "captured_at",
    "source_is_official",
    "stored_in_outputs_public",
    "stored_in_local_runs",
    "raw_heavy",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "snapshot_manifest_id": {
      "type": "string",
      "pattern": "^S17C17_MANIFEST_"
    },
    "raw_heavy": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    },
    "trainable": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    }
  }
}
