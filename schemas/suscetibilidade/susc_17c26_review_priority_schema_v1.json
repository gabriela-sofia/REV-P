{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C26 review priority schema v1",
  "type": "object",
  "required": [
    "review_priority_id",
    "candidate_patch_id",
    "event_id",
    "chirps_30d_sum_mm",
    "chirps_7d_sum_mm",
    "chirps_3d_sum_mm",
    "sentinel2_signal_available",
    "observational_delta_available",
    "artifact_completeness_score",
    "review_priority_index",
    "priority_class",
    "priority_reason",
    "not_risk_score",
    "not_training_label",
    "not_ground_truth",
    "review_only"
  ],
  "properties": {
    "review_priority_id": {
      "type": "string",
      "pattern": "^S17C26_PRIO_"
    },
    "not_risk_score": {
      "const": "true"
    },
    "not_training_label": {
      "const": "true"
    },
    "not_ground_truth": {
      "const": "true"
    },
    "review_only": {
      "const": "true"
    }
  }
}
