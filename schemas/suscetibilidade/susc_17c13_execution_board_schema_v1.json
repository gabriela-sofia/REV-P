{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C13 execution board schema v1",
  "type": "object",
  "required": [
    "execution_task_id",
    "formal_request_id",
    "provider_name",
    "priority",
    "task_order",
    "task_description",
    "task_status",
    "requires_human_action",
    "evidence_required_to_mark_done",
    "done",
    "review_only"
  ],
  "properties": {
    "execution_task_id": {
      "type": "string",
      "pattern": "^S17C13_TASK_"
    },
    "task_status": {
      "enum": [
        "pending"
      ]
    },
    "requires_human_action": {
      "const": "true"
    },
    "done": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    }
  }
}
