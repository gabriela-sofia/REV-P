      "const": "true"
    }
  },
  "enums": {
    "feature_source_mode": [
      "direta_por_dem_e_hidrografia_local",
      "direta_parcial_por_dem_local",
      "direta_parcial_por_hidrografia_local",
      "insumo_local_insuficiente",
