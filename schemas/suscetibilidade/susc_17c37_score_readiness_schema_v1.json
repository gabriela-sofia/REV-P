{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C37 score readiness schema v1",
  "type": "object",
  "required": [
    "score_replay_readiness_after_equivalence_id", "canary_patch_id", "previous_status_17c36",
    "method_equivalence_accepted", "method_calibration_possible", "topography_features_equivalent",
    "topography_features_calibratable", "can_compute_full_score_v6_replay",
    "can_compute_calibrated_score_v6_replay", "score_replay_status_after_17c37",
    "blocking_reason", "not_official_score", "does_not_replace_score_v6", "review_only"
  ],
  "properties": {
    "score_replay_readiness_after_equivalence_id": {"type": "string", "pattern": "^S17C37_RDY_"},
    "not_official_score": {"const": "true"},
    "does_not_replace_score_v6": {"const": "true"},
    "review_only": {"const": "true"}
  }
}
