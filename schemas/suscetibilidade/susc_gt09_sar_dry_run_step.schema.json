{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "susc_gt09_sar_dry_run_step.schema.json",
  "title": "SUSC-GT09 Etapa Dry-Run SAR",
  "type": "object",
  "required": [
    "dry_run_id",
    "sentinel1_target_id",
    "step",
    "executado_agora",
    "review_only"
  ],
  "properties": {
    "dry_run_id": {
      "type": "string",
      "pattern": "^DR_\\d+$"
    },
    "sentinel1_target_id": {
      "type": "string",
      "pattern": "^S1_\\d+$"
    },
    "step": {
      "type": "string",
      "minLength": 1
    },
    "executado_agora": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    }
  }
}
