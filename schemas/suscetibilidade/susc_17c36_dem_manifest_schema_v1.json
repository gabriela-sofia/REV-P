{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C36 dem manifest schema v1",
  "type": "object",
  "required": [
    "dem_artifact_manifest_id", "source_name", "source_authority", "artifact_local_path",
    "artifact_type", "sha256", "size_bytes", "crs", "resolution_m", "bbox",
    "stored_in_outputs_public", "raw_heavy", "usable_for_hydrologic_grid", "review_only"
  ],
  "properties": {
    "dem_artifact_manifest_id": {"type": "string", "pattern": "^S17C36_DEM_"},
    "stored_in_outputs_public": {"const": "false"},
    "review_only": {"const": "true"}
  }
}
