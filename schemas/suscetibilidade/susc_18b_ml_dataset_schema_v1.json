{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-18B ML ready dataset schema v1",
  "type": "object",
  "required": [
    "ml_sample_id", "unified_patch_id", "source_patch_id", "patch_family", "city", "region",
    "is_official_population_patch", "is_canary_patch", "is_control_patch", "review_only",
    "ground_truth", "training_label", "elevation_mean", "slope_mean", "HAND_value", "TWI_value",
    "TPI_250m_value", "flow_acc_available", "flow_acc_equivalent", "distance_to_official_drainage_m",
    "distance_to_official_water_m", "urban_prop", "vegetation_prop", "water_prop", "NDVI_mean",
    "NDWI_mean", "MNDWI_mean", "NDBI_mean", "chirps_3d_sum", "chirps_7d_sum", "chirps_30d_sum",
    "feature_family_available_count", "feature_completeness_ratio", "proxy_feature_count",
    "official_feature_count", "missing_feature_family_count", "score_v6_reference_value",
    "transparent_index_reference_value", "has_official_hydrological_occurrence_anchor",
    "score_v6_is_target", "transparent_index_is_target", "occurrence_anchor_is_target"
  ],
  "properties": {
    "ml_sample_id": {"type": "string", "pattern": "^S18B_SAMPLE_"},
    "patch_family": {"enum": ["official_population_patch", "event_anchored_canary_patch", "spatial_mismatch_control_candidate", "candidate_patch_existing"]},
    "review_only": {"const": "true"},
    "ground_truth": {"const": "false"},
    "training_label": {"const": "false"},
    "flow_acc_equivalent": {"const": "false"},
    "score_v6_is_target": {"const": "false"},
    "transparent_index_is_target": {"const": "false"},
    "occurrence_anchor_is_target": {"const": "false"}
  }
}
