{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C22 feature matrix schema v1",
  "type": "object",
  "required": [
    "candidate_patch_id",
    "event_id",
    "pre_event_scene_or_item_id",
    "source_role",
    "sensor_feature_matrix_status",
    "B03_mean",
    "B04_mean",
    "B08_mean",
    "B11_mean",
    "NDVI_mean",
    "NDWI_mean",
    "MNDWI_mean",
    "NDBI_mean",
    "features_real_count",
    "features_accepted_review_only_count",
    "usable_for_science_now",
    "usable_for_training",
    "ground_truth",
    "eligible_for_score_v7",
    "review_only"
  ],
  "properties": {
    "usable_for_science_now": {
      "const": "false"
    },
    "usable_for_training": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    },
    "eligible_for_score_v7": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    }
  }
}
