{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C5 normalized geometry",
  "type": "object",
  "description": "SUSC-17C5 review-only schema. No ground truth, no training, no score v7.",
  "required": [
    "candidate_event_id",
    "event_id",
    "region",
    "city",
    "source_id",
    "source_type",
    "geometry_id",
    "geometry_type",
    "geometry_source",
    "geometry_format",
    "crs",
    "has_geometry_object",
    "uncertainty_m",
    "geometry_resolution_status",
    "geometry_blocking_reason",
    "risk_context_only",
    "review_only",
    "eligible_for_training",
    "ground_truth",
    "score_v7_allowed"
  ],
  "properties": {
    "candidate_event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "geometry_id": {
      "type": "string",
      "minLength": 1
    },
    "geometry_type": {
      "enum": [
        "polygon",
        "point",
        "bbox",
        "technical_footprint",
        "unresolved_geometry"
      ]
    },
    "geometry_source": {
      "type": "string",
      "minLength": 1
    },
    "geometry_format": {
      "type": "string",
      "minLength": 1
    },
    "crs": {
      "type": "string",
      "minLength": 1
    },
    "has_geometry_object": {
      "enum": [
        "true",
        "false"
      ]
    },
    "uncertainty_m": {
      "type": "string",
      "minLength": 1
    },
    "geometry_resolution_status": {
      "type": "string",
      "minLength": 1
    },
    "geometry_blocking_reason": {
      "type": "string",
      "minLength": 1
    },
    "risk_context_only": {
      "enum": [
        "true",
        "false"
      ]
    },
    "review_only": {
      "const": "true"
    },
    "eligible_for_training": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    },
    "score_v7_allowed": {
      "const": "false"
    }
  },
  "additionalProperties": true
}
