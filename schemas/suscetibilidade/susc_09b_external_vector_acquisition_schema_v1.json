{
  "schema_version": "1.0",
  "schema_id": "SUSC-09B-EXTERNAL-VECTOR-ACQUISITION",
  "created": "2026-06-27",
  "acquisition_name": "SUSC-09B external official vector acquisition",
  "status": "review_only_external_vector_acquisition",
  "purpose": "Amplia a aquisicao de fontes oficiais/publicas (GeoCuritiba/IPPUC, APAC, Defesa Civil, SGB/CPRM, INEA, ANA, CEMADEN, INMET) com download controlado quando houver URL direta. Parsing vetorial pure-Python/lib padrao. NAO cria ground truth e NAO desbloqueia treino.",
  "priority_institutions": [
    "GeoCuritiba/IPPUC", "Prefeitura de Curitiba", "Defesa Civil Curitiba",
    "APAC", "Prefeitura do Recife", "Defesa Civil Recife",
    "SGB/CPRM", "Defesa Civil Petropolis", "INEA/RJ",
    "ANA/Hidroweb", "CEMADEN", "INMET", "MapBiomas"
  ],
  "download_rules": {
    "allowed_extensions": [".csv", ".geojson", ".json", ".kml", ".kmz", ".wkt", ".txt", ".pdf", ".zip"],
    "max_bytes": 104857600,
    "zip_allowed_if": ["direct_url", "official_source", "<=100MB", "vector_content_expected"],
    "forbidden": ["raster", "sentinel_imagery", ">100MB", "api_key", "google_maps", "generic_geocoding"]
  },
  "parser_support": {
    "geojson": "pure_python",
    "json": "pure_python",
    "csv_lat_lon": "pure_python",
    "wkt": "pure_python",
    "kml": "stdlib_xml_best_effort",
    "kmz": "stdlib_zip_xml_best_effort",
    "shapefile": "only_if_library_available_else_metadata_block",
    "pdf": "only_if_library_available_else_text_skip"
  },
  "integration_rules": [
    "tudo permanece requires_manual_review=true",
    "fonte oficial com geometria explicita pode ser spatial_evidence_candidate",
    "nada vira ground truth",
    "overlay candidate gerado se geometria suficiente",
    "limitacao sempre preservada"
  ],
  "can_be_ground_truth": false,
  "allowed_for_training": false,
  "review_only": true,
  "scientific_status": "external_official_vector_acquisition_not_patch_ground_truth"
}
