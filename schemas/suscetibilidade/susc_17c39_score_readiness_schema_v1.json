{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C39 score readiness schema v1",
  "type": "object",
  "required": [
    "score_replay_readiness_after_flow_solution_id", "canary_patch_id", "previous_status_17c38",
    "flow_acc_solution_type", "flow_acc_solution_validated", "topography_component_status",
    "can_compute_full_score_v6_replay", "can_compute_calibrated_score_v6_replay",
    "score_replay_status_after_17c39", "blocking_reason", "not_original_method",
    "does_not_modify_score_v6", "review_only"
  ],
  "properties": {
    "score_replay_readiness_after_flow_solution_id": {"type": "string", "pattern": "^S17C39_RDY_"},
    "does_not_modify_score_v6": {"const": "true"},
    "review_only": {"const": "true"}
  }
}
