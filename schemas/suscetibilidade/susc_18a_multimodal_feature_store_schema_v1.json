{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-18A multimodal patch feature store schema v1",
  "type": "object",
  "required": [
    "unified_patch_id", "source_patch_id", "patch_family", "city", "region",
    "event_anchor_available", "has_official_hydrological_occurrence_anchor",
    "absence_of_occurrence_is_true_negative", "NDVI_mean", "NDWI_mean", "MNDWI_mean", "NDBI_mean",
    "chirps_3d_sum", "chirps_7d_sum", "chirps_30d_sum", "elevation_mean", "slope_mean",
    "HAND_value", "TWI_value", "TPI_250m_value", "flow_acc_status",
    "distance_to_official_drainage_m", "distance_to_official_water_m",
    "urban_prop", "vegetation_prop", "water_prop", "sentinel2_available", "chirps_available",
    "terrain_available", "hydrology_available", "landcover_available",
    "transparent_components_available", "feature_family_available_count",
    "feature_completeness_ratio", "missing_feature_families", "proxy_feature_count",
    "official_feature_count", "review_only", "ground_truth", "training_label"
  ],
  "properties": {
    "unified_patch_id": {"type": "string", "pattern": "^S18A_PATCH_"},
    "patch_family": {"enum": ["official_population_patch", "event_anchored_canary_patch", "spatial_mismatch_control_candidate", "candidate_patch_existing"]},
    "absence_of_occurrence_is_true_negative": {"const": "false"},
    "review_only": {"const": "true"},
    "ground_truth": {"const": "false"},
    "training_label": {"const": "false"}
  }
}
