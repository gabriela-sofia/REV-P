{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C37 topography comparison schema v1",
  "type": "object",
  "required": [
    "comparison_id", "patch_id", "feature_name", "official_value", "recomputed_value",
    "absolute_error", "relative_error", "rank_official", "rank_recomputed",
    "same_order_bucket", "scale_compatible", "within_acceptance_threshold",
    "blocking_reason", "review_only"
  ],
  "properties": {
    "comparison_id": {"type": "string", "pattern": "^S17C37_CMP_"},
    "review_only": {"const": "true"}
  }
}
