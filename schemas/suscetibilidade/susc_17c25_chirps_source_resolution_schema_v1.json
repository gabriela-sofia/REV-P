{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C25 chirps source resolution schema v1",
  "type": "object",
  "required": [
    "source_resolution_id",
    "strategy_id",
    "strategy_name",
    "attempted",
    "network_enabled",
    "runtime_enabled",
    "source_resolved",
    "selected_for_computation",
    "resolution_status",
    "blocking_reason",
    "review_only"
  ],
  "properties": {
    "source_resolution_id": {
      "type": "string",
      "pattern": "^S17C25_SRCRES_"
    },
    "review_only": {
      "const": "true"
    }
  }
}
