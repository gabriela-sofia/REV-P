{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C21 artifact QA schema v1",
  "type": "object",
  "required": [
    "pre_event_qa_id",
    "candidate_patch_id",
    "scene_or_item_id",
    "artifact_manifest_id",
    "artifact_type",
    "artifact_exists",
    "sha256_matches",
    "size_within_limit",
    "format_allowed",
    "bands_expected_present",
    "indices_expected_present",
    "valid_pixel_count_positive",
    "preview_readable",
    "source_is_fallback",
    "fallback_role_correct",
    "is_pre_event",
    "passes_pre_event_qa",
    "blocking_reason",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "pre_event_qa_id": {
      "type": "string",
      "pattern": "^S17C21_PREQA_"
    },
    "review_only": {
      "const": "true"
    },
    "trainable": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    }
  }
}
