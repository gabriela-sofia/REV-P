{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C20 source resolution schema v1",
  "type": "object",
  "required": [
    "source_resolution_id",
    "candidate_patch_id",
    "scene_or_item_id",
    "primary_source",
    "primary_source_status",
    "fallback_source",
    "fallback_source_status",
    "selected_materialization_source",
    "source_role",
    "source_is_official_primary",
    "fallback_used",
    "source_resolution_status",
    "blocking_reason",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "source_resolution_id": {
      "type": "string",
      "pattern": "^S17C20_SRCRES_"
    },
    "source_is_official_primary": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    },
    "trainable": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    }
  }
}
