{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "susc_gt07_qa_form.schema.json",
  "title": "SUSC-GT07 Formulario de QA",
  "type": "object",
  "required": [
    "qa_form_id",
    "qa_queue_id",
    "qa_status_after_review"
  ],
  "properties": {
    "qa_form_id": {
      "type": "string",
      "pattern": "^QAF_\\d+$"
    },
    "qa_queue_id": {
      "type": "string",
      "pattern": "^QAQ_\\d+$"
    },
    "qa_status_after_review": {
      "enum": [
        "accepted",
        "rejected",
        "needs_more_source",
        "ambiguous",
        "phenomenon_mismatch",
        "temporal_mismatch",
        "spatial_mismatch",
        "no_data",
        "not_reviewed"
      ]
    },
    "reviewer_decision": {
      "type": "string"
    }
  }
}
