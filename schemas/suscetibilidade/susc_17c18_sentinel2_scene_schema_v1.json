{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C18 Sentinel-2 candidate scene schema v1",
  "type": "object",
  "required": [
    "candidate_scene_id",
    "candidate_patch_id",
    "event_id",
    "scene_or_item_id",
    "collection",
    "datetime",
    "platform",
    "product_type",
    "cloud_cover",
    "bbox_intersects_patch",
    "is_pre_event",
    "is_post_event",
    "downloaded",
    "tile_created",
    "usable_for_future_tile",
    "usable_for_pre_event_feature",
    "blocking_reason",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "candidate_scene_id": {
      "type": "string",
      "pattern": "^S17C18_SCENE_"
    },
    "downloaded": {
      "const": "false"
    },
    "tile_created": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    },
    "trainable": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    }
  }
}
