{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C19 temporal lineage schema v1",
  "type": "object",
  "required": [
    "event_temporal_lineage_id",
    "event_id",
    "source_reference_candidate_id",
    "upstream_source_file",
    "event_period_start",
    "event_period_end",
    "temporal_precision",
    "temporal_source_status",
    "used_for_sensor_windows",
    "parse_from_event_id",
    "blocking_reason",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "event_temporal_lineage_id": {
      "type": "string",
      "pattern": "^S17C19_TLINEAGE_"
    },
    "parse_from_event_id": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    },
    "trainable": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    }
  }
}
