{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C14 official response intake schema v1",
  "type": "object",
  "required": [
    "official_response_intake_id",
    "formal_request_id",
    "provider_name",
    "response_received",
    "response_received_at",
    "source_artifact_exists",
    "source_artifact_path_or_reference",
    "source_artifact_sha256",
    "source_artifact_format",
    "source_checked_at",
    "provider_type",
    "official_source_reference",
    "source_is_official",
    "channel_id",
    "channel_status",
    "license_or_use_terms",
    "classification",
    "manual_review_required",
    "eligible_for_gate_evaluation",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "official_response_intake_id": {
      "type": "string",
      "pattern": "^S17C14_INTAKE_"
    },
    "response_received": {
      "const": "false"
    },
    "source_artifact_exists": {
      "const": "false"
    },
    "source_artifact_sha256": {
      "const": "not_available"
    },
    "classification": {
      "enum": [
        "accepted_ground_reference_candidate",
        "received_needs_normalization",
        "received_needs_spatial_qa",
        "received_missing_required_fields",
        "received_wrong_phenomenon",
        "received_temporal_leakage_risk",
        "received_unverifiable_source",
        "received_context_only",
        "rejected_not_official",
        "rejected_sensitive_or_unsafe"
      ]
    },
    "review_only": {
      "const": "true"
    },
    "trainable": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    }
  }
}
