{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C19 tile request schema v1",
  "type": "object",
  "required": [
    "tile_request_id",
    "candidate_patch_id",
    "event_id",
    "canonical_scene_selection_id",
    "scene_or_item_id",
    "requested_tile_type",
    "requested_bands",
    "requested_resolution_m",
    "requested_output_format",
    "max_size_bytes",
    "storage_policy",
    "can_execute_now",
    "requires_network",
    "requires_download_policy",
    "requires_storage_policy",
    "requires_no_raw_heavy",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "tile_request_id": {
      "type": "string",
      "pattern": "^S17C19_TILEREQ_"
    },
    "can_execute_now": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    },
    "trainable": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    }
  }
}
