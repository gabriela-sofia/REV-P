{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-18B experiment registry schema v1",
  "type": "object",
  "required": [
    "experiment_id", "experiment_type", "method", "feature_groups", "sample_count",
    "uses_labels", "uses_ground_truth", "uses_score_v6_as_target", "status", "output_files",
    "review_only"
  ],
  "properties": {
    "experiment_type": {"enum": ["unsupervised_review_only", "supervised_blocked"]},
    "uses_labels": {"const": "false"},
    "uses_ground_truth": {"const": "false"},
    "uses_score_v6_as_target": {"const": "false"},
    "review_only": {"const": "true"}
  }
}
