{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C17 light raster policy schema v1",
  "type": "object",
  "required": [
    "light_raster_policy_id",
    "sensor_or_dataset",
    "allowed_output_type",
    "max_size_bytes",
    "allowed_formats",
    "allowed_resolution_policy",
    "allowed_storage",
    "commit_allowed",
    "requires_network_opt_in",
    "requires_no_raw_heavy",
    "requires_manifest",
    "requires_hash",
    "review_only"
  ],
  "properties": {
    "light_raster_policy_id": {
      "type": "string",
      "pattern": "^S17C17_RASTERPOLICY_"
    },
    "review_only": {
      "const": "true"
    }
  }
}
