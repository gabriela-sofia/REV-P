{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "susc_gt08_query_spec.schema.json",
  "title": "SUSC-GT08 Especificacao de Consulta Sentinel-1",
  "type": "object",
  "required": [
    "query_spec_id",
    "sentinel1_target_id",
    "collection_policy",
    "instrument",
    "product_type",
    "acquisition_mode",
    "polarization_required",
    "metadata_only",
    "no_download",
    "remote_execution_allowed_now",
    "review_only"
  ],
  "properties": {
    "query_spec_id": {
      "type": "string",
      "pattern": "^QS_\\d+$"
    },
    "sentinel1_target_id": {
      "type": "string",
      "pattern": "^S1_\\d+$"
    },
    "collection_policy": {
      "const": "sentinel1_grd"
    },
    "instrument": {
      "const": "SAR"
    },
    "product_type": {
      "const": "GRD"
    },
    "acquisition_mode": {
      "const": "IW"
    },
    "polarization_required": {
      "const": "VV,VH"
    },
    "metadata_only": {
      "const": "true"
    },
    "no_download": {
      "const": "true"
    },
    "remote_execution_allowed_now": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    }
  }
}
