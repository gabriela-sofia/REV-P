{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C26 evidence graph schema v1",
  "type": "object",
  "required": [
    "node_id",
    "node_type",
    "object_id",
    "candidate_patch_id",
    "event_id",
    "label",
    "source_dataset",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "pattern": "^S17C26_NODE_"
    },
    "review_only": {
      "const": "true"
    },
    "trainable": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    }
  }
}
