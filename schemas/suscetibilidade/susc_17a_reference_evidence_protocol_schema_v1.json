{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17A reference evidence protocol schema",
  "type": "object",
  "description": "Formal fail-closed schema for the SUSC-17A Reference Evidence Protocol. It classifies observed reference evidence (events, footprints, sources, uncertainty, quality and use eligibility) while separating four logical objects: event_record, source_footprint, derived_patch_link and score_evaluation_reference. It never creates score v7, training data, supervised labels, models, ground truth, or true negatives. Observed footprints stay candidate evidence; documentary absence is never a true negative. Only the three strong classes may ever support strong evaluation, and none becomes ground truth.",
  "required": [
    "reference_evidence_id",
    "source_id",
    "event_id",
    "geometry_id",
    "patch_link_id",
    "patch_id",
    "event_date",
    "pre_event_window",
    "post_event_window",
    "city",
    "region",
    "phenomenon_type",
    "geometry_type",
    "spatial_resolution",
    "temporal_resolution",
    "source_authority",
    "source_confidence",
    "annotation_method",
    "uncertainty_m",
    "link_quality",
    "evidence_class",
    "quality_tier",
    "reference_level",
    "represents_observed_occurrence",
    "eligible_for_evaluation",
    "eligible_for_strong_evaluation",
    "eligible_for_calibration",
    "eligible_for_score_v7_future",
    "review_only",
    "trainable",
    "ground_truth",
    "not_ground_truth_reason",
    "no_negative_control_reason",
    "source_artifact",
    "lineage_notes"
  ],
  "properties": {
    "reference_evidence_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "geometry_id": { "type": "string", "minLength": 1 },
    "patch_link_id": { "type": "string", "minLength": 1 },
    "patch_id": { "type": "string", "minLength": 1 },
    "event_date": { "type": "string", "minLength": 1 },
    "pre_event_window": { "type": "string", "minLength": 1 },
    "post_event_window": { "type": "string", "minLength": 1 },
    "city": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "phenomenon_type": { "type": "string", "minLength": 1 },
    "geometry_type": { "type": "string", "minLength": 1 },
    "spatial_resolution": { "type": "string", "minLength": 1 },
    "temporal_resolution": { "type": "string", "minLength": 1 },
    "source_authority": { "type": "string", "minLength": 1 },
    "source_confidence": { "type": "string", "minLength": 1 },
    "annotation_method": { "type": "string", "minLength": 1 },
    "uncertainty_m": { "type": "string", "minLength": 1 },
    "link_quality": { "type": "string", "minLength": 1 },
    "evidence_class": {
      "enum": [
        "official_observed_event_polygon",
        "official_observed_event_point",
        "technical_remote_sensing_flood_footprint",
        "official_address_resolved",
        "street_neighborhood_context_only",
        "risk_area_not_event",
        "alert_only",
        "administrative_disaster_record",
        "documentary_context",
        "rejected_non_event",
        "insufficient_reference"
      ]
    },
    "quality_tier": {
      "enum": [
        "TIER_A_STRONG_GEOMETRY_DATED",
        "TIER_B_MODERATE_GEOMETRY_PATCH_LINKED",
        "TIER_C_COARSE_GEOMETRY_UNLINKED",
        "TIER_D_CONTEXT_NO_PATCH_VALIDATION",
        "TIER_E_INSUFFICIENT"
      ]
    },
    "reference_level": {
      "enum": [
        "event_record",
        "source_footprint",
        "derived_patch_link",
        "score_evaluation_reference"
      ]
    },
    "represents_observed_occurrence": { "enum": ["true", "false"] },
    "eligible_for_evaluation": { "enum": ["true", "false"] },
    "eligible_for_strong_evaluation": { "enum": ["true", "false"] },
    "eligible_for_calibration": { "enum": ["true", "false"] },
    "eligible_for_score_v7_future": { "const": "false" },
    "review_only": { "const": "true" },
    "trainable": { "const": "false" },
    "ground_truth": { "const": "false" },
    "not_ground_truth_reason": { "type": "string", "minLength": 1 },
    "no_negative_control_reason": { "type": "string", "minLength": 1 },
    "source_artifact": { "type": "string", "minLength": 1 },
    "lineage_notes": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
