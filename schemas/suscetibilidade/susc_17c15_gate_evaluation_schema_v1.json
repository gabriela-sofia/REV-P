{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C15 gate evaluation schema v1",
  "type": "object",
  "required": [
    "gate_eval_id",
    "formal_request_id",
    "artifact_manifest_id",
    "G1_existencia_documental",
    "G2_confiabilidade_fonte",
    "G3_precisao_temporal",
    "G4_vinculo_espacial",
    "G5_separacao_fenomeno",
    "G6_proveniencia_integridade",
    "G7_anti_leakage",
    "all_gates_passed",
    "acceptance_status",
    "blocking_reason",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "gate_eval_id": {
      "type": "string",
      "pattern": "^S17C15_GATE_"
    },
    "acceptance_status": {
      "enum": [
        "accepted_ground_reference_candidate",
        "received_needs_normalization",
        "received_needs_spatial_qa",
        "received_missing_required_fields",
        "received_wrong_phenomenon",
        "received_temporal_leakage_risk",
        "received_unverifiable_source",
        "received_context_only",
        "rejected_not_official",
        "rejected_sensitive_or_unsafe",
        "blocked_no_artifact"
      ]
    },
    "ground_truth": {
      "const": "false"
    },
    "trainable": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    }
  }
}
