{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C7 extraction task schema",
  "type": "object",
  "description": "Plano de tarefas review-only para extracao futura de camadas multimodais em patches candidatos. O plano nao executa raster, SAR, DINO/SatMAE ou score.",
  "required": [
    "extraction_task_id",
    "candidate_patch_id",
    "feature_layer",
    "task_name",
    "task_type",
    "input_required",
    "expected_output",
    "can_run_now",
    "why_not_now",
    "estimated_dependency",
    "must_not_commit_raw_raster",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "extraction_task_id": { "type": "string", "pattern": "^S17C7_TASK_" },
    "candidate_patch_id": { "type": "string", "pattern": "^S17C6_CANARY_REC_" },
    "feature_layer": {
      "enum": [
        "physical_static",
        "urban_territorial",
        "sentinel2_spectral",
        "rainfall_trigger",
        "documentary_evidence",
        "sar_observational",
        "embedding_representation"
      ]
    },
    "task_name": { "type": "string", "minLength": 1 },
    "task_type": {
      "enum": [
        "reuse_existing_pipeline",
        "adapt_existing_pipeline_to_candidate_patch",
        "requires_external_artifact",
        "requires_runtime_credentials",
        "requires_manual_review",
        "blocked_until_patch_policy",
        "not_applicable"
      ]
    },
    "input_required": { "type": "string", "minLength": 1 },
    "expected_output": { "type": "string", "minLength": 1 },
    "can_run_now": { "const": "false" },
    "why_not_now": { "type": "string", "minLength": 1 },
    "estimated_dependency": { "type": "string", "minLength": 1 },
    "must_not_commit_raw_raster": { "const": "true" },
    "review_only": { "const": "true" },
    "trainable": { "const": "false" },
    "ground_truth": { "const": "false" }
  },
  "additionalProperties": true
}
