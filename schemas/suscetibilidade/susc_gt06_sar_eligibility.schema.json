{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "susc_gt06_sar_eligibility.schema.json",
  "title": "SUSC-GT06 Elegibilidade SAR",
  "type": "object",
  "required": [
    "eligibility_id",
    "sar_target_id",
    "sar_canary_eligibility",
    "can_execute_sar_now",
    "no_sar_execution_in_this_milestone",
    "no_network_in_this_milestone",
    "no_raster_download_in_this_milestone",
    "review_only"
  ],
  "properties": {
    "eligibility_id": {
      "type": "string",
      "pattern": "^ELG_\\d+$"
    },
    "sar_target_id": {
      "type": "string",
      "pattern": "^SAR_\\d+$"
    },
    "sar_canary_eligibility": {
      "enum": [
        "elegivel_canario_sar_prioritario",
        "elegivel_canario_sar_secundario",
        "requer_geometria_antes_do_sar",
        "requer_separacao_fenomenologica",
        "bloqueado_temporalmente",
        "bloqueado_por_contexto_fraco",
        "nao_elegivel_para_sar"
      ]
    },
    "can_prepare_sar_future": {
      "enum": [
        "true",
        "false"
      ]
    },
    "can_execute_sar_now": {
      "const": "false"
    },
    "no_sar_execution_in_this_milestone": {
      "const": "true"
    },
    "no_network_in_this_milestone": {
      "const": "true"
    },
    "no_raster_download_in_this_milestone": {
      "const": "true"
    },
    "review_only": {
      "const": "true"
    }
  }
}
