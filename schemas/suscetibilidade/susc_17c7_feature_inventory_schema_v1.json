{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C7 candidate patch feature inventory schema",
  "type": "object",
  "description": "Inventario review-only para planejar extracao futura de camadas multimodais em patches candidatos. Nao cria patch oficial, patch-link oficial, score v7, treino, label ou ground truth.",
  "required": [
    "candidate_patch_id",
    "candidate_grid_id",
    "event_id",
    "feature_name",
    "feature_layer",
    "required_for_future_score",
    "required_for_future_embedding",
    "required_for_review_only_evaluation",
    "available_now",
    "available_from_existing_official_patch_pipeline",
    "available_from_existing_raw_artifact",
    "requires_new_extraction",
    "requires_external_download",
    "requires_runtime_credentials",
    "requires_raster_processing",
    "requires_human_review",
    "usable_for_science_now",
    "synthetic_placeholder",
    "blocking_reason",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "candidate_patch_id": { "type": "string", "pattern": "^S17C6_CANARY_REC_" },
    "candidate_grid_id": { "const": "S17C6_CANARY_GRID_RECIFE_CHARTER758_V1" },
    "event_id": { "const": "REC_2022_05_24_30" },
    "feature_name": { "type": "string", "minLength": 1 },
    "feature_layer": {
      "enum": [
        "physical_static",
        "urban_territorial",
        "sentinel2_spectral",
        "rainfall_trigger",
        "documentary_evidence",
        "sar_observational",
        "embedding_representation"
      ]
    },
    "required_for_future_score": { "enum": ["true", "false"] },
    "required_for_future_embedding": { "enum": ["true", "false"] },
    "required_for_review_only_evaluation": { "enum": ["true", "false"] },
    "available_now": { "enum": ["true", "false"] },
    "available_from_existing_official_patch_pipeline": { "enum": ["true", "false"] },
    "available_from_existing_raw_artifact": { "enum": ["true", "false"] },
    "requires_new_extraction": { "enum": ["true", "false"] },
    "requires_external_download": { "enum": ["true", "false"] },
    "requires_runtime_credentials": { "enum": ["true", "false"] },
    "requires_raster_processing": { "enum": ["true", "false"] },
    "requires_human_review": { "enum": ["true", "false"] },
    "usable_for_science_now": { "const": "false" },
    "synthetic_placeholder": { "enum": ["true", "false"] },
    "blocking_reason": { "type": "string", "minLength": 1 },
    "review_only": { "const": "true" },
    "trainable": { "const": "false" },
    "ground_truth": { "const": "false" }
  },
  "additionalProperties": true
}
