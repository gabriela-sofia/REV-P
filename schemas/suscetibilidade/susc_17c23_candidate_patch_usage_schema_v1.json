{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C23 candidate patch usage schema v1",
  "type": "object",
  "required": [
    "patch_usage_decision_id",
    "candidate_patch_id",
    "event_id",
    "has_geometry_aoi",
    "has_candidate_event_link",
    "has_temporal_binding",
    "has_real_feature_with_hash_replay",
    "fallback_source_resolved",
    "not_official_patch",
    "not_official_patch_link",
    "usage_decision_status",
    "usable_for_science_now",
    "usable_for_training",
    "ground_truth",
    "eligible_for_score_v7",
    "eligible_for_17b",
    "review_only"
  ],
  "properties": {
    "patch_usage_decision_id": {
      "type": "string",
      "pattern": "^S17C23_PUDEC_"
    },
    "usable_for_training": {
      "const": "false"
    },
    "ground_truth": {
      "const": "false"
    },
    "eligible_for_score_v7": {
      "const": "false"
    },
    "eligible_for_17b": {
      "const": "false"
    },
    "review_only": {
      "const": "true"
    }
  }
}
