{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C6 embedding contract schema",
  "type": "object",
  "description": "Contrato review-only para interface futura de embeddings DINOv2, SatMAE ou Scale-MAE. Sem tile real, o marco permite apenas smoke test sintetico deterministico, nao cientifico e nao treinavel.",
  "required": [
    "contract_id",
    "milestone_category",
    "supported_models",
    "expected_input",
    "expected_shape",
    "expected_crs_policy",
    "expected_resolution_policy",
    "expected_embedding_dim",
    "normalization_policy",
    "cloud_policy",
    "missing_tile_policy",
    "synthetic_smoke_test_policy",
    "not_scientific_until_real_tile",
    "real_embedding_created",
    "synthetic_embedding_smoke_test_created",
    "review_only",
    "trainable",
    "ground_truth"
  ],
  "properties": {
    "contract_id": { "const": "SUSC_17C6_EMBEDDING_CONTRACT_V1" },
    "milestone_category": { "const": "canario_de_aplicabilidade_multimodal_review_only" },
    "supported_models": {
      "type": "array",
      "contains": { "enum": ["DINOv2", "SatMAE", "Scale-MAE"] }
    },
    "expected_input": { "type": "string", "minLength": 1 },
    "expected_shape": { "type": "object" },
    "expected_crs_policy": { "type": "string", "minLength": 1 },
    "expected_resolution_policy": { "type": "string", "minLength": 1 },
    "expected_embedding_dim": { "type": "object" },
    "normalization_policy": { "type": "string", "minLength": 1 },
    "cloud_policy": { "type": "string", "minLength": 1 },
    "missing_tile_policy": { "type": "string", "minLength": 1 },
    "synthetic_smoke_test_policy": { "type": "string", "minLength": 1 },
    "not_scientific_until_real_tile": { "const": true },
    "real_embedding_created": { "const": false },
    "synthetic_embedding_smoke_test_created": { "const": true },
    "review_only": { "const": true },
    "trainable": { "const": false },
    "ground_truth": { "const": false }
  },
  "additionalProperties": true
}
