{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUSC-17C31 sar metadata feasibility schema v1",
  "type": "object",
  "required": [
    "sar_metadata_feasibility_id",
    "candidate_patch_id",
    "event_id",
    "event_period_start",
    "event_period_end",
    "aoi_bbox",
    "pre_event_s1_scene_count",
    "during_or_post_event_s1_scene_count",
    "matching_orbit_available",
    "vv_available",
    "vh_available",
    "metadata_source",
    "metadata_artifact_manifest_id",
    "sar_footprint_generation_feasible",
    "requires_future_raster_processing",
    "review_only"
  ],
  "properties": {
    "sar_metadata_feasibility_id": {"type": "string", "pattern": "^S17C31_SARF_"},
    "requires_future_raster_processing": {"const": "true"},
    "review_only": {"const": "true"}
  }
}
