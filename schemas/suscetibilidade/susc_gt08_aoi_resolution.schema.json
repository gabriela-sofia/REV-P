{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "susc_gt08_aoi_resolution.schema.json",
  "title": "SUSC-GT08 Resolucao de AOI",
  "type": "object",
  "required": [
    "aoi_resolution_id",
    "sentinel1_target_id",
    "aoi_status",
    "sufficient_for_search",
    "review_only",
    "no_geometry_created_in_this_milestone"
  ],
  "properties": {
    "aoi_resolution_id": {
      "type": "string",
      "pattern": "^AOI_\\d+$"
    },
    "sentinel1_target_id": {
      "type": "string",
      "pattern": "^S1_\\d+$"
    },
    "aoi_status": {
      "enum": [
        "aoi_forte_por_bbox_ou_geometria_patch",
        "aoi_parcial_por_centroide_ou_ponto",
        "aoi_contextual_insuficiente",
        "aoi_ausente",
        "aoi_invalida"
      ]
    },
    "sufficient_for_search": {
      "enum": [
        "true",
        "false"
      ]
    },
    "review_only": {
      "const": "true"
    },
    "no_geometry_created_in_this_milestone": {
      "const": "true"
    }
  }
}
