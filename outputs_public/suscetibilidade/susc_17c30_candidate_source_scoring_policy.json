{
  "policy_id": "S17C30_POLICY_V1",
  "policy_version": "v1",
  "signals": [
    {
      "signal_id": "S17C30_SIG_01",
      "signal_name": "source_authority_score",
      "scale_min": 0,
      "scale_max": 3,
      "description": "autoridade institucional/oficial da fonte"
    },
    {
      "signal_id": "S17C30_SIG_02",
      "signal_name": "artifact_acquisition_score",
      "scale_min": 0,
      "scale_max": 3,
      "description": "artefato leve adquirido com sha256 e manifesto"
    },
    {
      "signal_id": "S17C30_SIG_03",
      "signal_name": "event_specificity_score",
      "scale_min": 0,
      "scale_max": 3,
      "description": "artefato cita o evento especifico"
    },
    {
      "signal_id": "S17C30_SIG_04",
      "signal_name": "temporal_signal_score",
      "scale_min": 0,
      "scale_max": 3,
      "description": "data/periodo do evento presente no texto"
    },
    {
      "signal_id": "S17C30_SIG_05",
      "signal_name": "spatial_signal_score",
      "scale_min": 0,
      "scale_max": 3,
      "description": "localidade/bairro/logradouro citado no texto"
    },
    {
      "signal_id": "S17C30_SIG_06",
      "signal_name": "phenomenon_signal_score",
      "scale_min": 0,
      "scale_max": 3,
      "description": "fenomeno (inundacao/deslizamento/chuva) citado"
    },
    {
      "signal_id": "S17C30_SIG_07",
      "signal_name": "parseability_score",
      "scale_min": 0,
      "scale_max": 3,
      "description": "parse deterministico com texto extraido"
    },
    {
      "signal_id": "S17C30_SIG_08",
      "signal_name": "linkage_potential_score",
      "scale_min": 0,
      "scale_max": 3,
      "description": "vinculavel a candidato de patch / evento"
    },
    {
      "signal_id": "S17C30_SIG_09",
      "signal_name": "multimodal_trigger_score",
      "scale_min": 0,
      "scale_max": 3,
      "description": "capaz de disparar follow-up CHIRPS/Sentinel/SAR/QA"
    },
    {
      "signal_id": "S17C30_SIG_10",
      "signal_name": "promotion_safety_score",
      "scale_min": 0,
      "scale_max": 3,
      "description": "fail-closed: proibe promocao para GT/label/score/17B"
    }
  ],
  "classes": [
    {
      "class_code": "A",
      "class_name": "A_institutional_event_candidate",
      "rule": "total>=23 e authority>=2 e acquisition>=2 e parseability>=2 e event_specificity>=2",
      "allowed_uses": [
        "documentary_evidence",
        "event_record_candidate",
        "multimodal_followup_trigger",
        "documentary_gate_support"
      ],
      "blocked_uses": [
        "ground_truth",
        "training_label",
        "score_v7",
        "17B_unlock",
        "patch_positive_label"
      ]
    },
    {
      "class_code": "B",
      "class_name": "B_official_context_candidate",
      "rule": "total>=18 e authority>=2",
      "allowed_uses": [
        "documentary_evidence",
        "context_anchor",
        "documentary_gate_support"
      ],
      "blocked_uses": [
        "ground_truth",
        "training_label",
        "score_v7",
        "17B_unlock"
      ]
    },
    {
      "class_code": "C",
      "class_name": "C_technical_sensor_candidate",
      "rule": "authority tecnica com potencial de follow-up espacial (SAR/GeoJSON)",
      "allowed_uses": [
        "multimodal_followup_trigger",
        "geometry_seed_candidate"
      ],
      "blocked_uses": [
        "event_observation",
        "ground_truth",
        "training_label",
        "score_v7"
      ]
    },
    {
      "class_code": "D",
      "class_name": "D_documentary_support_only",
      "rule": "total>=12",
      "allowed_uses": [
        "documentary_support",
        "context_anchor"
      ],
      "blocked_uses": [
        "ground_truth",
        "training_label",
        "score_v7",
        "17B_unlock",
        "ground_reference_candidate"
      ]
    },
    {
      "class_code": "E",
      "class_name": "E_weak_news_context",
      "rule": "noticia comercial/triage sem autoridade institucional",
      "allowed_uses": [
        "weak_context_only"
      ],
      "blocked_uses": [
        "ground_reference_candidate",
        "ground_truth",
        "training_label",
        "score_v7"
      ]
    },
    {
      "class_code": "F",
      "class_name": "F_rejected",
      "rule": "total<12 ou sem aquisicao/parse minimos",
      "allowed_uses": [],
      "blocked_uses": [
        "all_uses"
      ]
    }
  ],
  "review_only": true,
  "trainable": false,
  "ground_truth": false
}
