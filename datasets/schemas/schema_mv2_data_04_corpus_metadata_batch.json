{
  "schema_id": "mv2_data_04_corpus_metadata_batch",
  "title": "MV2-DATA-04 Corpus Metadata Batch",
  "validates": "outputs_public/mv2_data_corpus_metadata_probe/mv2_data_04_corpus_metadata_batch.csv",
  "primary_key": "target_id",
  "max_rows": 15,
  "max_per_region": 5,
  "required_fields": [
    "batch_id",
    "target_id",
    "asset_id",
    "patch_id",
    "region",
    "bbox",
    "crs",
    "priority",
    "selected_for_probe",
    "selection_reason",
    "is_official_canary",
    "can_probe_metadata",
    "blocking_reason"
  ],
  "fail_closed_rules": [
    "no máximo 15 targets; até 5 por região (Recife/Petropolis/Curitiba)",
    "nenhum official canary Protocolo-C (is_official_canary=false)",
    "nenhum target sem bbox/CRS",
    "selected_for_probe não implica execução: probe ainda exige janela temporal + config"
  ]
}
