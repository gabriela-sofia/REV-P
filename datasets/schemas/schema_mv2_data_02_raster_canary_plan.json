{
  "schema_id": "mv2_data_02_raster_canary_plan",
  "title": "MV2-DATA-02 Raster Canary Plan",
  "validates": "outputs_public/mv2_data_api_raster_harness/mv2_data_02_raster_canary_plan.csv",
  "primary_key": "canary_id",
  "max_rows": 3,
  "required_fields": [
    "canary_id",
    "target_id",
    "asset_id",
    "patch_id",
    "region",
    "product_id",
    "scene_id",
    "datetime",
    "bbox",
    "crs",
    "bands_requested",
    "scl_requested",
    "private_output_dir",
    "estimated_size_mb",
    "canary_allowed_by_data",
    "canary_allowed_by_config",
    "download_allowed_now",
    "crop_allowed_now",
    "blocking_reason",
    "next_action"
  ],
  "minimum_bands": ["B02", "B03", "B04", "B08", "B11", "B12", "SCL"],
  "fail_closed_rules": [
    "download_allowed_now=false por padrão",
    "crop_allowed_now=false por padrão",
    "private_output_dir obrigatório (local_only/ | data_local/ | private_outputs/)",
    "outputs_public nunca recebe raster",
    "canary_allowed_by_data=true só com scene_id+datetime+crs (lineage forte)"
  ]
}
