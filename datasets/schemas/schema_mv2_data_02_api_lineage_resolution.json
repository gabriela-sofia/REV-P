{
  "schema_id": "mv2_data_02_api_lineage_resolution",
  "title": "MV2-DATA-02 API Lineage Resolution",
  "validates": "outputs_public/mv2_data_api_raster_harness/mv2_data_02_api_lineage_resolution.csv",
  "primary_key": "resolution_id",
  "required_fields": [
    "resolution_id",
    "target_id",
    "asset_id",
    "patch_id",
    "region",
    "product_id",
    "scene_id",
    "datetime",
    "mgrs_tile",
    "cloud_cover",
    "source_providers",
    "provider_agreement",
    "lineage_status",
    "can_promote_to_stac_dry_run",
    "can_promote_to_raster_canary",
    "can_promote_to_bulk_download",
    "blocking_reason",
    "next_action"
  ],
  "enums": {
    "lineage_status": [
      "API_LINEAGE_RESOLVED_STRONG",
      "API_LINEAGE_RESOLVED_PARTIAL",
      "API_LINEAGE_REVIEW_REQUIRED",
      "API_LINEAGE_CONFLICT",
      "API_LINEAGE_NOT_EXECUTED",
      "API_LINEAGE_NOT_FOUND",
      "API_LINEAGE_INVALID"
    ]
  },
  "fail_closed_rules": [
    "can_promote_to_bulk_download=false sempre neste marco",
    "can_promote_to_raster_canary=true só com lineage_status forte e config permitindo",
    "can_promote_to_stac_dry_run=true só com bbox+CRS+datetime+collection",
    "datetime futuro nunca é aceito (API_LINEAGE_INVALID)",
    "match só por cidade/tile nunca promove lineage"
  ]
}
