{
  "schema_id": "mv2_data_05_temporal_evidence_validation",
  "title": "MV2-DATA-05 Temporal Evidence Validation",
  "validates": "outputs_public/mv2_data_temporal_window_intake/mv2_data_05_temporal_evidence_validation.csv",
  "primary_key": "validation_id",
  "required_fields": [
    "validation_id",
    "target_id",
    "asset_id",
    "patch_id",
    "region",
    "temporal_window_start",
    "temporal_window_end",
    "temporal_window_source",
    "source_ref",
    "review_status",
    "window_days",
    "future_date",
    "start_after_end",
    "asset_patch_match",
    "source_present",
    "review_approved",
    "too_broad",
    "evidence_status",
    "blocking_reason",
    "notes"
  ],
  "enums": {
    "evidence_status": [
      "TEMPORAL_EVIDENCE_VALID_STRONG",
      "TEMPORAL_EVIDENCE_VALID_PARTIAL",
      "TEMPORAL_EVIDENCE_REVIEW_REQUIRED",
      "TEMPORAL_EVIDENCE_EMPTY",
      "TEMPORAL_EVIDENCE_CONFLICT",
      "TEMPORAL_EVIDENCE_INVALID"
    ]
  },
  "fail_closed_rules": [
    "STRONG exige target existente, asset/patch match, datas válidas não-futuras, start<=end, janela<=45d (ou justificada), source+source_ref e review aprovado",
    "PARTIAL exige datas válidas e source_ref, faltando review final",
    "data futura/start>end/sem fonte/target inexistente/mismatch => INVALID ou CONFLICT"
  ]
}
