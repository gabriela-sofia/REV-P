{
  "schema_id": "mv2_data_02_private_raster_validation",
  "title": "MV2-DATA-02 Private Raster Intake Validation",
  "validates": "outputs_public/mv2_data_api_raster_harness/mv2_data_02_private_raster_validation.csv",
  "primary_key": "validation_id",
  "required_fields": [
    "validation_id",
    "canary_id",
    "raster_executed",
    "private_path_registered",
    "public_leak_detected",
    "file_exists_private",
    "size_bytes",
    "sha256",
    "bands_ok",
    "scl_ok",
    "crs_ok",
    "geotransform_ok",
    "validation_status",
    "notes"
  ],
  "validation_status_values": [
    "NO_RASTER_EXECUTED",
    "PRIVATE_RASTER_VALID",
    "INVALID_PUBLIC_OR_NONPRIVATE_PATH",
    "INVALID_FILE_MISSING",
    "INVALID_BANDS_OR_SCL"
  ],
  "fail_closed_rules": [
    "se nada foi executado, status=NO_RASTER_EXECUTED e validação passa (OK)",
    "public_leak_detected=true invalida o intake",
    "raster precisa estar fora de outputs_public, com bandas mínimas + SCL + checksum"
  ]
}
