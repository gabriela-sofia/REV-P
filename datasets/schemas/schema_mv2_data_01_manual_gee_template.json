{
  "schema_id": "mv2_data_01_manual_gee_template",
  "title": "MV2-DATA-01 Manual GEE Lineage Template",
  "validates": "outputs_public/mv2_data_gee_lineage_targets/mv2_data_01_manual_gee_lineage_template.csv",
  "primary_key": "target_id",
  "required_fields": [
    "target_id",
    "asset_id",
    "patch_id",
    "region",
    "bbox",
    "crs",
    "gee_collection",
    "product_id",
    "scene_id",
    "acquisition_datetime",
    "mgrs_tile",
    "cloudy_pixel_percentage",
    "cloud_coverage_assessment",
    "nodata_pixel_percentage",
    "datatake_identifier",
    "generation_time",
    "spacecraft_name",
    "export_task_name",
    "export_script_path_or_name",
    "evidence_ref",
    "filled_by",
    "reviewed_by",
    "review_status",
    "notes"
  ],
  "must_be_empty_until_human_fill": [
    "gee_collection",
    "product_id",
    "scene_id",
    "acquisition_datetime",
    "mgrs_tile",
    "cloudy_pixel_percentage",
    "cloud_coverage_assessment",
    "nodata_pixel_percentage",
    "datatake_identifier",
    "generation_time",
    "spacecraft_name",
    "export_task_name",
    "export_script_path_or_name",
    "evidence_ref",
    "filled_by",
    "reviewed_by"
  ],
  "fail_closed_rules": [
    "nenhum campo de lineage é pré-preenchido; valores só por checagem humana no GEE",
    "product_id/scene_id/acquisition_datetime/mgrs_tile/cloud nunca por inferência",
    "T23KPR (ou qualquer tile MGRS) nunca é vínculo automático"
  ]
}
