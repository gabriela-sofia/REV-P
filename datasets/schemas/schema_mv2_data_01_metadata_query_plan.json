{
  "schema_id": "mv2_data_01_metadata_query_plan",
  "title": "MV2-DATA-01 Metadata-Only Query Plans (GEE + STAC/OData)",
  "validates": [
    "outputs_public/mv2_data_gee_lineage_targets/mv2_data_01_gee_metadata_query_plan.csv",
    "outputs_public/mv2_data_gee_lineage_targets/mv2_data_01_stac_odata_metadata_plan.csv"
  ],
  "primary_key": "query_id",
  "required_fields_gee": [
    "query_id",
    "target_id",
    "asset_id",
    "patch_id",
    "region",
    "source_collection",
    "aoi_source",
    "bbox",
    "crs",
    "suggested_date_window_start",
    "suggested_date_window_end",
    "metadata_fields_to_collect",
    "would_call_gee",
    "would_export_raster",
    "execution_status",
    "reason_not_executed",
    "next_action"
  ],
  "required_fields_stac_odata": [
    "query_id",
    "target_id",
    "provider",
    "endpoint_type",
    "collection",
    "bbox_or_intersects_source",
    "datetime_or_range",
    "query_payload_or_filter",
    "expected_metadata_fields",
    "would_execute_http",
    "would_download",
    "execution_status",
    "reason_not_executed",
    "next_action"
  ],
  "providers": [
    "CDSE_STAC",
    "CDSE_ODATA",
    "GEE_METADATA"
  ],
  "minimum_metadata_fields": [
    "PRODUCT_ID",
    "MGRS_TILE",
    "system:time_start",
    "CLOUDY_PIXEL_PERCENTAGE",
    "CLOUD_COVERAGE_ASSESSMENT",
    "NODATA_PIXEL_PERCENTAGE",
    "DATATAKE_IDENTIFIER",
    "GENERATION_TIME",
    "SPACECRAFT_NAME"
  ],
  "fail_closed_rules": [
    "would_call_gee=false em todas as linhas do plano GEE",
    "would_export_raster=false em todas as linhas do plano GEE",
    "would_execute_http=false em todas as linhas do plano STAC/OData",
    "would_download=false em todas as linhas do plano STAC/OData",
    "execution_status=NOT_EXECUTED_PLAN_ONLY em todas as linhas",
    "suggested_date_window é limite do arquivo Sentinel-2, não data de aquisição do alvo"
  ]
}
