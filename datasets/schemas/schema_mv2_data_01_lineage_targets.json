{
  "schema_id": "mv2_data_01_lineage_targets",
  "title": "MV2-DATA-01 GEE Lineage Targets",
  "validates": "outputs_public/mv2_data_gee_lineage_targets/mv2_data_01_lineage_targets.csv",
  "primary_key": "target_id",
  "required_fields": [
    "target_id",
    "binding_id",
    "anchor_id",
    "asset_id",
    "patch_id",
    "region",
    "sensor",
    "platform",
    "bbox",
    "crs",
    "has_asset_id",
    "has_patch_id",
    "has_bbox",
    "has_crs",
    "has_scene_id",
    "has_datetime",
    "has_tile",
    "has_cloud_cover",
    "lineage_status",
    "priority",
    "blocking_reason",
    "next_action"
  ],
  "enums": {
    "lineage_status": [
      "TARGET_READY_FOR_MANUAL_GEE_LOOKUP",
      "TARGET_READY_FOR_METADATA_QUERY_PLAN",
      "TARGET_BLOCKED_MISSING_PATCH",
      "TARGET_BLOCKED_MISSING_ASSET",
      "TARGET_BLOCKED_MISSING_GEOMETRY",
      "TARGET_BLOCKED_MISSING_CRS",
      "TARGET_INVALID"
    ],
    "priority": [
      "P0_HIGH_SENSOR_CONFIRMED_QUERY",
      "P1_MEDIUM_LOCAL_CANDIDATE_REVIEW",
      "P2_LOW_NO_LOCAL_SCENE_QUERY",
      "P3_BLOCKED_INCOMPLETE"
    ]
  },
  "fail_closed_rules": [
    "has_scene_id/has_datetime/has_tile/has_cloud_cover só são true com evidência já recuperada na matriz de lineage MV2-14",
    "datetime futuro nunca conta como has_datetime=true",
    "cidade/região/zona UTM nunca estabelecem lineage forte",
    "nenhuma cena (ex.: T23KPR) é auto-vinculada por tile/zona"
  ]
}
